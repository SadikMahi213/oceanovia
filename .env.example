APP_NAME=MulitVendor USA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ─── DATABASE ──────────────────────────────────────────────────────────────
# Production: DB_CONNECTION=pgsql (or mysql)
# Dev: DB_CONNECTION=sqlite (single-user only)
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=multivendor
# DB_USERNAME=postgres
# DB_PASSWORD=
#
# For MySQL use:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=multivendor
# DB_USERNAME=root
# DB_PASSWORD=

# ─── SESSION ───────────────────────────────────────────────────────────────
# Production: SESSION_DRIVER=redis (requires redis running & phpredis extension)
# Fallback:   SESSION_DRIVER=database (run php artisan session:table && migrate)
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── QUEUE ─────────────────────────────────────────────────────────────────
# Production: QUEUE_CONNECTION=redis (with supervisor running queue:work)
# Fallback:   QUEUE_CONNECTION=database
# Production: run `php artisan queue:work --sleep=3 --tries=3 --max-time=3600`
# Linux with supervisor: `sudo supervisorctl reread && sudo supervisorctl update`
# Windows: use Task Scheduler to run `php artisan queue:work --stop-when-empty` every minute (run php artisan queue:table && migrate)
QUEUE_CONNECTION=redis

# ─── CACHE ─────────────────────────────────────────────────────────────────
# Production: CACHE_STORE=redis
# Fallback:   CACHE_STORE=file
CACHE_STORE=redis

# ─── REDIS ─────────────────────────────────────────────────────────────────
# Required for production. Install phpredis extension.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── MAIL ──────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@multivendor.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── AWS / S3 ──────────────────────────────────────────────────────────────
# Required in production when FILESYSTEM_DISK=s3
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── STRIPE ────────────────────────────────────────────────────────────────
STRIPE_KEY=pk_test_xxx
STRIPE_SECRET=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── VITE ──────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
